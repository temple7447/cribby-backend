# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL=sqlite+aiosqlite:///./campus.db
SECRET_KEY=change-me-in-production

# Resend (https://resend.com) — used to send .edu verification codes.
# Leave RESEND_API_KEY empty for local dev: codes are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Cribby <onboarding@resend.dev>
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# Cloudinary (https://cloudinary.com) — used for listing photo uploads.
# Leave CLOUDINARY_CLOUD_NAME empty for local dev: photo upload endpoints
# return 503 instead of crashing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
