# Copy to .env and fill in real values. .env is gitignored.
# Identical to the Python backend's settings — the same values work unchanged,
# including the SQLAlchemy-style driver suffixes ("+aiosqlite", "+asyncpg").

DATABASE_URL=sqlite+aiosqlite:///./campus.db
SECRET_KEY=change-me-in-production
# Use the SAME SECRET_KEY as the Python deployment and already-issued login tokens stay valid.

# HTTP port (Render sets PORT itself).
PORT=8000

# Resend (https://resend.com) — used to send verification / password-reset / booking emails.
# Leave RESEND_API_KEY empty for local dev: codes are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Cribby <noreply@cribby.space>
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# Cloudinary (https://cloudinary.com) — listing / avatar / banner photos.
# Leave CLOUDINARY_CLOUD_NAME empty for local dev: upload endpoints return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: JSON array or comma-separated list. Defaults to localhost dev ports + admin.cribby.space.
# BACKEND_CORS_ORIGINS=["http://localhost:8081","https://admin.cribby.space"]
